{
  "name": "vot-hrenoviy-sovet",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-font": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "reactotron-react-native": "^5.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:api": "node --import ./scripts/register-aliases.mjs --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-api.ts",
    "doctor": "npx expo-doctor",
    "build:android:preview": "NODE_ENV=development eas build --platform android --profile preview --local --clear-cache",
    "build:android:development": "NODE_ENV=development eas build --platform android --profile development --local --clear-cache",
    "build:android:prod": "NODE_ENV=production eas build --platform android --profile production --local --clear-cache",
    "build:android:prod-apk": "NODE_ENV=production eas build --platform android --profile production-apk --local --clear-cache",
    "submit:android": "eas submit --platform android --profile production"
  },
  "private": true
}
