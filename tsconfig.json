{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@types": ["./src/types"],
      "@types/*": ["./src/types/*"],
      "@api": ["./src/api"],
      "@api/*": ["./src/api/*"],
      "@config": ["./src/config"],
      "@config/*": ["./src/config/*"],
      "@components": ["./src/components"],
      "@components/*": ["./src/components/*"]
    }
  }
}
